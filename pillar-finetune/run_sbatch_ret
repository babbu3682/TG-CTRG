#!/bin/bash

# Retrieval task launcher (the single canonical entry point for this task —
# see run_sbatch_abn for the abn classification counterpart).
#
# Usage: sbatch run_sbatch_ret [config_file] [exp_name] [notes]
#   (forwarded to scripts/run_ctrate_retrieval.sh — see that file for details)
#
# 인자 없이 `sbatch run_sbatch_ret`만 치면 아래 DEFAULT_* (phrase_align_split 비교 런)로
# 실행된다. 큐가 밀릴 때 다른 계정에서 그대로 제출할 수 있도록 기본값을 박아둔 것.
#
# ⚠️ 다른 유저 아이디로 제출하기 전에 확인할 것 (제출 계정이 kyungs2가 아니면 필요):
#   1) ~/logs 디렉토리가 있어야 한다  ->  mkdir -p ~/logs
#      (--output이 /home/%u/logs/ 로 바뀌어 제출한 계정의 홈으로 간다)
#   2) 이 저장소의 logs/CTRATE/ 에 쓰기 권한이 있어야 체크포인트가 저장된다.
#      현재 drwxr-s--- kyungs2 drdcad 라 그룹에 쓰기 비트가 없다. 소유자(kyungs2)가
#         chmod -R g+w logs/CTRATE && chmod g+w logs
#      를 해주거나, 제출 시 --opts main.checkpoints_dir <쓰기가능경로> 로 우회할 것.
#      스크립트가 시작 시 직접 검사해서 안 되면 즉시 중단한다(아래 preflight).
#   3) 데이터/체크포인트는 drdcad 그룹 읽기 권한이면 충분하다(확인함).
# When running a comparison variant (e.g. different text embedding pooling),
# pass a distinct exp_name AND override --job-name so it's distinguishable both
# in squeue/sacct and in its checkpoints directory (logs/CTRATE/<exp_name>/):
#   sbatch --job-name=finetune_ret_lasthidden run_sbatch_ret \
#       configs/ctrate_retrieval_finetune_lz4_pillar_opensource.yaml \
#       CTRATE_FT_Atlas_retrieval_pillar_freeze_lasthidden
#
# sacct -r gpu -S 2026-06-01 --format=JobID,JobName%20,Partition,State,Start,End,ExitCode,NodeList | grep finetune_ret
# 예상 시작 체크: squeue --start -u $USER -o "%.18i %.9P %.30j %.2t %20S %.6D %20R"
# GPU 체크  : srun --overlap nvidia-smi --jobid=<JOBID>

# SBatch Logging and mailing
# %u = 제출한 계정 이름. 계정마다 자기 홈의 ~/logs로 간다(없으면 미리 mkdir).
#SBATCH --output /home/%u/logs/%x-%A.out
# mail-user는 일부러 비워둠 — 지정하지 않으면 SLURM이 제출한 계정으로 보낸다.
# 특정 주소로 받고 싶으면 제출 시 sbatch --mail-user=... 로 주면 된다.
#SBATCH --mail-type END,TIME_LIMIT_90
#SBATCH --extra SLURM_MAIL_QUEUED_MINS=1,SLURM_MAIL_RUN_MINS=1

########## SBatch Reservation and runtime : gpu (a100) 스펙: Cores 32, CPUs 64, GPUs 4, Mem 243g

#SBATCH --job-name finetune_ret_phrase_align_split
# 5일 — 기준선(job 26978948, 오픈소스 인코더)과 **동일하게** 유지한다. 이 런은 activ
# 토큰이 절반(32,768 vs 65,536)이라 더 짧게 잡아도 되지만, walltime이 다르면 한쪽만
# 잘렸을 때 본 epoch 수가 달라져 "인코더만 바꾼 비교"가 성립하지 않는다. 기준선이
# 50 epoch을 3d04h에 끝냈으므로 5일이면 양쪽 다 여유가 있다.
# (짧은 walltime이 backfill에 유리한 건 맞지만, 비교 런에서는 조건 일치가 우선.)
#SBATCH --time 5-00:00:00
#SBATCH --partition gpu
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=16
#SBATCH --mem 60g

# (EXTRA)
##SBATCH --dependency afterany:<JOB-ID>
##SBATCH --qos cpu

AVAILABLE_CPUS=$(nproc)
echo "자동으로 계산된 CPU 개수: $AVAILABLE_CPUS"

# ⚠️ WANDB_API_KEY는 저장소에 두지 않는다 — origin이 공용 저장소(YalaLab/pillar-finetune)라
# 커밋하면 그대로 공개된다. /data/drdcad/sunggu/.wandb_key 에 export WANDB_API_KEY="..." 를
# 한 줄로 두고(chmod 600) 여기서 읽는다. 없으면 조용히 넘어가지 않고 즉시 죽는다.
WANDB_KEY_FILE="${WANDB_KEY_FILE:-/data/drdcad/sunggu/.wandb_key}"
if [ -z "${WANDB_API_KEY:-}" ] && [ -r "$WANDB_KEY_FILE" ]; then . "$WANDB_KEY_FILE"; fi
: "${WANDB_API_KEY:?WANDB_API_KEY 없음 — $WANDB_KEY_FILE 을 만들거나 환경변수로 주세요}"
export WANDB_API_KEY

module load singularity

# printf %q-escape each positional arg individually before interpolating into
# the "bash -lc '<string>'" wrapper below — naive '$1' '$2' '$3' quoting
# breaks (silent syntax-error exit) if any arg (e.g. notes text) contains an
# apostrophe, as happened with job 26976251's notes string.
# 인자를 안 주면 phrase_align_split 비교 런으로 기본 실행 (위 Usage 참고).
DEFAULT_CONFIG="configs/ctrate_retrieval_finetune_lz4_pillar_self_phrase_align_split.yaml"
DEFAULT_EXP="CTRATE_FT_Atlas_retrieval_self_phrase_align_split"
DEFAULT_NOTES="Retrieval with PhraseAlign-Split self-pretrained encoder (phrase_align_split_pillar0_lz4_v1/epoch_10, frozen, eval-pinned): activ -> Simple_TranSQ, last-token text cache + last-token gallery. Encoder-only swap vs opensource Pillar0-ChestCT baseline (job 26978948: val_loss 0.6222 @ ep48, match_recall@1 0.2173)."

CONFIG="${1:-$DEFAULT_CONFIG}"
EXP_NAME="${2:-$DEFAULT_EXP}"
NOTES="${3:-$DEFAULT_NOTES}"
echo "config=$CONFIG"
echo "exp_name=$EXP_NAME"

# --- preflight: 다른 계정에서 돌릴 때 조용히 실패하는 두 지점을 미리 잡는다 ---
REPO=/data/drdcad/sunggu/0.Challenge/VLM3D_MICCAI/pillar-finetune
if [ ! -r "$REPO/$CONFIG" ]; then
    echo "ERROR: config를 읽을 수 없습니다: $REPO/$CONFIG (권한 또는 경로 확인)" >&2
    exit 1
fi
if [ ! -w "$REPO/logs/CTRATE" ]; then
    echo "ERROR: $REPO/logs/CTRATE 에 쓰기 권한이 없습니다 (계정: $(whoami))." >&2
    echo "       소유자가 'chmod g+w logs logs/CTRATE' 를 해주거나," >&2
    echo "       제출 시 main.checkpoints_dir 을 쓰기 가능한 경로로 override 하세요." >&2
    exit 1
fi

QUOTED_ARGS=$(printf '%q ' "$CONFIG" "$EXP_NAME" "$NOTES")

singularity exec --nv \
    -B /vf,/data,/spin1 \
    -B /data/drdcad/sunggu:/workspace \
    -B /data/MIDS/datasets/CT-RATE:/workspace/0.Challenge/goto_dataset \
    "/data/drdcad/sunggu/.singularity_images/cuda-12.2.2-cudnn8-devel-ubuntu22.04.sif" \
    bash -lc "bash /data/drdcad/sunggu/0.Challenge/VLM3D_MICCAI/pillar-finetune/scripts/run_ctrate_retrieval.sh $QUOTED_ARGS"


