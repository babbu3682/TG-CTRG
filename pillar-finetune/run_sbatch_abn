#!/bin/bash

# Abn classification task launcher (the single canonical entry point for this
# task — see run_sbatch_ret for the retrieval counterpart, and
# run_sbatch_abn_probe_revise for the standalone frozen-feature linear/MLP
# probing pipeline used to quickly compare pretrain checkpoints).
#
# Usage: sbatch run_sbatch_abn [config_file] [exp_name] [notes]
#   (forwarded to scripts/run_ctrate_abnclass.sh — see that file for details)
# When running a comparison variant, pass a distinct exp_name AND override
# --job-name so it's distinguishable both in squeue/sacct and in its
# checkpoints directory (logs/CTRATE/<exp_name>/).
# 실제 제출한 커맨드 기록은 이 파일 맨 아래 참고.
#
# sacct -r gpu -S 2026-06-01 --format=JobID,JobName%20,Partition,State,Start,End,ExitCode,NodeList | grep finetune_abn

# SBatch Logging and mailing
#SBATCH --output ${LOG_DIR:-./logs}/%x-%A.out
#SBATCH --mail-user <your-email>
#SBATCH --mail-type END,TIME_LIMIT_90
#SBATCH --extra SLURM_MAIL_QUEUED_MINS=1,SLURM_MAIL_RUN_MINS=1

########## SBatch Reservation and runtime : gpu (a100) 스펙: Cores 32, CPUs 64, GPUs 4, Mem 243g

#SBATCH --job-name finetune_abn
#SBATCH --time 5-00:00:00
#SBATCH --partition gpu
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=16
#SBATCH --mem 60g

AVAILABLE_CPUS=$(nproc)
echo "자동으로 계산된 CPU 개수: $AVAILABLE_CPUS"

# ⚠️ WANDB_API_KEY는 저장소에 두지 않는다 — origin이 공용 저장소(YalaLab/pillar-finetune)라
# 커밋하면 그대로 공개된다. /data/drdcad/sunggu/.wandb_key 에 export WANDB_API_KEY="..." 를
# 한 줄로 두고(chmod 600) 여기서 읽는다. 없으면 조용히 넘어가지 않고 즉시 죽는다.
WANDB_KEY_FILE="${WANDB_KEY_FILE:-/data/drdcad/sunggu/.wandb_key}"
if [ -z "${WANDB_API_KEY:-}" ] && [ -r "$WANDB_KEY_FILE" ]; then . "$WANDB_KEY_FILE"; fi
: "${WANDB_API_KEY:?WANDB_API_KEY 없음 — $WANDB_KEY_FILE 을 만들거나 환경변수로 주세요}"
export WANDB_API_KEY

module load singularity

# printf %q-escape each positional arg individually before interpolating into
# the "bash -lc '<string>'" wrapper below — see run_sbatch_ret for why (job
# 26976251 died to a shell syntax error from unescaped apostrophes in NOTES).
QUOTED_ARGS=$(printf '%q ' "$1" "$2" "$3")

singularity exec --nv \
    -B /vf,/data,/spin1 \
    -B /data/drdcad/sunggu:/workspace \
    -B /data/MIDS/datasets/CT-RATE:/workspace/0.Challenge/goto_dataset \
    "/data/drdcad/sunggu/.singularity_images/cuda-12.2.2-cudnn8-devel-ubuntu22.04.sif" \
    bash -lc "bash /data/drdcad/sunggu/0.Challenge/VLM3D_MICCAI/pillar-finetune/scripts/run_ctrate_abnclass.sh $QUOTED_ARGS"


